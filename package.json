{
  "name": "kube-lens-lite",
  "version": "0.1.0",
  "description": "A lightweight, read-only Kubernetes cluster viewer for any cloud or on-prem cluster in your kubeconfig",
  "main": "./out/main/index.js",
  "type": "module",
  "author": "Babu Ganesan",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist:win": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "@kubernetes/client-node": "^1.0.0",
    "js-yaml": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
